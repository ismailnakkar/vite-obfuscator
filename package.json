        "vite",
        "vite-plugin",
        "obfuscation",
        "javascript-obfuscator",
        "code-protection"
    ],
    "homepage": "https://github.com/ismailnakkar/vite-obfuscator",
    "bugs": {
        "url": "https://github.com/ismailnakkar/vite-obfuscator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ismailnakkar/vite-obfuscator.git"
    },
    "license": "MIT",
    "author": {
        "name": "Ismail Nakkar",
        "email": "juge.steam@gmail.com"
    },
    "type": "module",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js"
        }
    },
    "files": [
        "src"
    ],
    "publishConfig": {
