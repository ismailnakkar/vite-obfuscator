    },
    "peerDependencies": {
        "javascript-obfuscator": "^5.4.7",
        "vite": "^8.0.0"
    },
    "devDependencies": {
        "javascript-obfuscator": "^5.4.7",
        "vite": "^8.3.0",
        "vitest": "^4.1.11"
